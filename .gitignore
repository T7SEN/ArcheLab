# Local-only planning doc. Agents read it by path; it is never committed.
docs/SPEC.md

# Local-only research reports and their source notes. Agents read them by path.
reports/
research_notes/

# Local-only architecture decision records. Agents read them by path.
docs/adr/

# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
*.tsbuildinfo
# Regenerated by Next.js; CI must generate it before typecheck
next-env.d.ts

# Vercel CLI link and local build output
.vercel/

# Environment files
.env
.env.*
!.env.example

# Test output. Playwright screenshot baselines (*-snapshots/) are committed on purpose.
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
pnpm-debug.log*
npm-debug.log*

# Claude Code personal files (.claude/settings.json stays committed)
.claude/settings.local.json
CLAUDE.local.md

# Keys and certificates
*.pem

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
